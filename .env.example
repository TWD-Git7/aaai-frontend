WORDPRESS_API_URL=http://localhost/aaai-portal-v1/wordpress/wp-json
# Alternative when pretty permalinks are unavailable:
# WORDPRESS_API_URL=http://localhost/aaai-portal-v1/wordpress/?rest_route=/
# Fill only with official, confirmed AAAI contact details.
AAAI_CONTACT_EMAIL=
AAAI_WHATSAPP_NUMBER=
AAAI_CONTACT_ADDRESS=
# Header contacts: defaults follow the reference supplied for AAAI.
AAAI_CONTACT_PHONE="+244 924 217 955"
# Set an official existing portal URL to enable direct member access.
AAAI_MEMBER_URL=
# Set the same private key in WordPress and on the Next.js server.
AAAI_ATENDIMENTO_API_KEY=
